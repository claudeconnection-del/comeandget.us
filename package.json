{
  "name": "comeandget-us",
  "version": "1.0.0",
  "private": true,
  "description": "A static cryptographic ARG landing page for comeandget.us",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "validate": "html-validate \"site/**/*.html\"",
    "test": "playwright test",
    "test:tools": "node --test \"tools/test/**/*.test.mjs\"",
    "seed:gauntlet": "node tools/seed-gauntlet.mjs",
    "walk:gauntlet": "node tools/walk-gauntlet.mjs",
    "ci": "npm run validate && npm run test:tools && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "html-validate": "^9.5.3",
    "wrangler": "^3.99.0"
  }
}
